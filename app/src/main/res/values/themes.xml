<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Your existing main app theme -->
    <style name="Theme.UmarMasjid" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Modern Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash window -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- Centered splash icon (replace with your masjid logo or launcher icon) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/umar_masjid_ic</item>

        <!-- Tells the system to switch back to your main theme once loaded -->
        <item name="postSplashScreenTheme">@style/Theme.UmarMasjid</item>
    </style>

</resources>